    // -------------------------------------------------
    //  SARS-CoV-2 (SC2, tax_id = 2697049, master = NC_045512)
    // -------------------------------------------------

    // Quick verification profile: small GenBank sample + landmark Pango panel in tree_free mode
    SC2_test {
        params {
            tax_id            = "2697049"
            db_name           = "SC2_test"
            publish_dir       = "${projectDir}/test_out/SC2_test"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "1"
            tree_free         = true
            skip_clustering   = true
            mmseqs_fast       = true

            ref_list          = "${projectDir}/test_data/sc2_test_ref_list.tsv"
            gene_info         = "${projectDir}/generic/sc2/Tables/gene_info.tsv"

            // Server-side full-genome prefilter + strict high-coverage / very-low-N QC
            // (clinical ARTIC/Midnight assemblies commonly mask ~90-140 terminal UTR primer bases with Ns)
            entrez_filter          = "29500:30200[SLEN] NOT patent[Division] NOT synthetic[Division]"
            fetch_sleep_time       = 0
            min_seq_length_ratio   = 0.98
            min_total_length       = 29500
            min_real_length        = 29350
            max_n_count            = 150     // <= ~0.50% Ns across 29.9 kb (blocks any amplicon dropout while allowing primer-end masking)
            max_ambig_fraction     = 0.005   // <= 0.50% total Ns + IUPAC wobbles
            max_aln_gap_proportion = 0.025   // >= 97.5% alignment column coverage

            mmseqs_min_seq_id       = 0.999
            mmseqs_min_completeness = 0.98
            max_threads             = 16
            test_max_cluster_seqs   = 100
        }
    }

    // Extended 48-thread NCBI test build using all strictly clean (<=150 N) GenBank Pango lineage references
    // + 2,000 sampled NCBI queries in treeless mode to validate the full reference backbone & QC
    SC2_ncbi_extended_test {
        params {
            tax_id            = "2697049"
            db_name           = "SC2_ncbi_extended_test"
            publish_dir       = "${projectDir}/test_out/SC2_ncbi_extended_test"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "1"
            tree_free         = true
            skip_clustering   = true
            mmseqs_fast       = true
            max_threads       = 48

            // All strictly QC-verified (<=150 N, >=29,350 ATGC) GenBank Pango lineage references + NC_045512 master
            ref_list          = "${projectDir}/generic/sc2/ref_list_pango_all_genbank.tsv"
            gene_info         = "${projectDir}/generic/sc2/Tables/gene_info.tsv"

            // Sample 2,000 full-length NCBI query candidates alongside all clean GenBank references
            entrez_filter     = "29500:30200[SLEN] NOT patent[Division] NOT synthetic[Division]"
            test_fetch_count  = 2000
            fetch_batch_size  = 10000
            efetch_batch_size = 200
            efetch_workers    = 6
            fetch_sleep_time  = 0

            min_seq_length_ratio   = 0.98
            min_total_length       = 29500
            min_real_length        = 29350
            max_n_count            = 150
            max_ambig_fraction     = 0.005
            max_aln_gap_proportion = 0.025

            mmseqs_min_seq_id       = 0.999
            mmseqs_min_completeness = 0.98
            test_max_cluster_seqs   = 1000
        }
    }

    // Production 48-thread NCBI build: treeless mode (for recycling an UShER tree),
    // MMseqs skipped upfront (run scripts/AddPosthocClustersToDb.py afterwards if time permits),
    // strictly QC-verified (<=150 N) GenBank Pango reference set, and strict full-genome QC.
    SC2_ncbi_highqc {
        params {
            tax_id            = "2697049"
            db_name           = "SC2_ncbi_highqc"
            publish_dir       = "${projectDir}/test_out/SC2_ncbi_highqc"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "0"
            tree_free         = true
            skip_clustering   = true
            mmseqs_fast       = true
            max_threads       = 48

            // Strictly QC-verified (<=150 N, >=29,350 ATGC) GenBank Pango lineage references + NC_045512 master
            // (or switch to ref_list_pango_diversity.tsv for the ~1,400 major-parent subset)
            ref_list          = "${projectDir}/generic/sc2/ref_list_pango_all_genbank.tsv"
            gene_info         = "${projectDir}/generic/sc2/Tables/gene_info.tsv"

            // High-throughput API-key-paced NCBI download + server-side full-genome filter
            entrez_filter     = "29500:30200[SLEN] NOT patent[Division] NOT synthetic[Division]"
            fetch_batch_size  = 10000
            efetch_batch_size = 200
            efetch_workers    = 6
            fetch_sleep_time  = 0

            // Strict full-genome, very high coverage, very low N / ambiguity filtering
            // Allows <=150 Ns (~0.5% of genome = terminal 5'/3' primer masking) while rejecting any amplicon dropout
            min_seq_length_ratio   = 0.98    // >= 98% of shortest ref in unambiguous ATGC
            min_total_length       = 29500   // full coding genome (266..29674) + flanking UTRs
            min_real_length        = 29350   // length - Ns >= 29,350 bp
            max_n_count            = 150     // <= 150 Ns (~0.50% of 29,903 bp; GISAID 'High coverage' is <1% = 299 Ns)
            max_ambig_fraction     = 0.005   // <= 0.50% total Ns + IUPAC ambiguity codes
            max_aln_gap_proportion = 0.025   // >= 97.5% alignment column coverage post-Nextalign

            mmseqs_min_seq_id       = 0.999
            mmseqs_min_completeness = 0.98
        }
    }

    // Combined GISAID EpiCoV + GenBank production build from scratch using verified clean
    // hybrid GISAID EPI_ISL_* + GenBank Pango designations (treeless, MMseqs deferred).
    SC2_gisaid_highqc {
        params {
            tax_id            = "2697049"
            db_name           = "SC2_gisaid_highqc"
            publish_dir       = "${projectDir}/test_out/SC2_gisaid_highqc"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "0"
            tree_free         = true
            skip_clustering   = true
            mmseqs_fast       = true
            max_threads       = 48

            ref_list          = "${projectDir}/generic/sc2/ref_list_pango_gisaid_hybrid.tsv"
            gene_info         = "${projectDir}/generic/sc2/Tables/gene_info.tsv"
            gisaid_col_map    = "${projectDir}/generic/sc2/column_mapping.tsv"
            gisaid_key        = "Accession_Id"
            gisaid_dir        = "${projectDir}/dev/SC2_prep"

            entrez_filter     = "29500:30200[SLEN] NOT patent[Division] NOT synthetic[Division]"
            fetch_batch_size  = 10000
            efetch_batch_size = 200
            efetch_workers    = 6
            fetch_sleep_time  = 0

            min_seq_length_ratio   = 0.98
            min_total_length       = 29500
            min_real_length        = 29350
            max_n_count            = 150
            max_ambig_fraction     = 0.005
            max_aln_gap_proportion = 0.025

            mmseqs_min_seq_id       = 0.999
            mmseqs_min_completeness = 0.98
        }
    }

    // Incremental GISAID EpiCoV update onto an existing SC2_ncbi_highqc.db build
    // (reuses the stored clean GenBank backbone without re-downloading/re-aligning NCBI).
    SC2_gisaid_update {
        params {
            tax_id            = "2697049"
            db_name           = "SC2_ncbi_plus_gisaid_highqc"
            update_db         = "${projectDir}/test_out/SC2_ncbi_highqc/SC2_ncbi_highqc.db"
            publish_dir       = "${projectDir}/test_out/SC2_ncbi_plus_gisaid_highqc"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "0"
            tree_free         = true
            skip_clustering   = true
            mmseqs_fast       = true
            max_threads       = 48

            ref_list          = "${projectDir}/generic/sc2/ref_list_pango_all_genbank.tsv"
            gene_info         = "${projectDir}/generic/sc2/Tables/gene_info.tsv"
            gisaid_col_map    = "${projectDir}/generic/sc2/column_mapping.tsv"
            gisaid_key        = "Accession_Id"
            gisaid_dir        = "${projectDir}/dev/SC2_prep"

            entrez_filter     = "29500:30200[SLEN] NOT patent[Division] NOT synthetic[Division]"
            fetch_batch_size  = 10000
            efetch_batch_size = 200
            efetch_workers    = 6
            fetch_sleep_time  = 0

            min_seq_length_ratio   = 0.98
            min_total_length       = 29500
            min_real_length        = 29350
            max_n_count            = 150
            max_ambig_fraction     = 0.005
            max_aln_gap_proportion = 0.025

            mmseqs_min_seq_id       = 0.999
            mmseqs_min_completeness = 0.98
        }
    }
    

}