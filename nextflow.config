            test_max_cluster_seqs = 40
        }
    }


    flu_gisaid_test {
        params {
            // Core Identity
            tax_id            = "11320"
            db_name           = "iav-db" // Inferred name
            is_segmented      = "Y"
            is_flu            = "Y"
            extra_info_fill   = false 
            test              = "1"

            // Input Files
            ref_list          = "${projectDir}/generic/influenza/ref_list_refmast.txt"
            gene_info         = "${projectDir}/generic/influenza/Tables/gene_info.tsv"
