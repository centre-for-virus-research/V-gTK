

conda.enabled = true


// list of profiles:
// standard;conda;test;setup_rabv_test_update;segmented_test;segmented_base_tree;flu_gisaid_test;HCV_test;h10n8_xml_test;
//setup_rabv_full;HCV_full;flu_gisaid_xml_laura;

// -------------------------------------------------
//  1. SHARED / DEFAULT PARAMETERS
// -------------------------------------------------
// These are the defaults used if not overwritten by a specific profile.
// Useful for directory structures or fallbacks.

params {
    // Pipeline Defaults
    publish_dir     = "results"
    email           = "your_email@example.com"
    xml_dir         = null
    update_file     = null

    // ESearch page size when listing accessions from NCBI (GenBankFetcher -b).
    // This is the accession *listing* page size only -- the EFetch batch that
    // actually downloads XML is fixed at 100 and is unaffected.
    // NCBI serves up to 10,000 per request; 100,000 returns a 500. Small values
    // are what made the listing take thousands of requests and trip rate limits.
    fetch_batch_size = 5000
    
    
    // Logic Defaults (Safety fallbacks)
    test            = "0"
    extra_info_fill = false
    is_segmented    = "N"
    is_flu          = "N"
    tree_free       = false
    base_tree_only  = false

    // MMseqs clustering. Two-step is the default: clustering a padded MSA in one
    // pass lets fragments become cluster representatives and therefore tree tips
    // (35% of influenza HA representatives were >25% gaps). Step 1 clusters only
    // near-complete sequences; step 2 assigns the rest to those clusters.
    mmseqs_two_step        = true
    mmseqs_min_completeness = 0.9    // step 2 always assigns at mmseqs_min_seq_id

    // Per-isolate segment completeness (PIVOT_TABLE_SEGMENTS)
    pivot_isolate_key       = null   // null => elect from Parsed_strain,isolate,strain
    pivot_required_segments = null   // null => derive from the ref_list master rows

    // Segment-name asset (VALIDATE_SEGMENT). TSV of segment/segment_name/aliases.
    // NOTE the asset is per-SPECIES, not per-genus: influenza B inverts segments 1
    // and 2 relative to A (IBV 1=PB1, 2=PB2), so the IAV file below is wrong for
    // IBV and a B build needs its own.
    // Populates the derived `segment_name` column and lets a submitter-declared
    // segment NAME (GISAID ships HA/NA/PB1 where we key on 1..8) be translated to
    // the canonical segment number instead of being discarded.
    segment_names           = null   // null => no name mapping; segment_name stays empty
    host_aliases            = null   // optional species-specific host alias TSV merged with assets/host_mapping.tsv
    strain_location_aliases = null   // optional geographic alias TSV for segmented strain linkage

    // Threading defaults
    max_threads       = 4
    test_max_cluster_seqs = null

    // IQ-TREE substitution model. GTR alone assumes every site evolves at the same
    // rate, which is wrong for a protein-coding viral gene - 3rd codon positions
    // evolve far faster. On influenza HA (1,000 taxa) +G4 improved BIC by 17,400
    // for ~42% more runtime; +I added only 168 more BIC for a further 74%.
    // The tree is stored in the DB, so it is worth fitting properly.
    iqtree_model      = "GTR+G4"

    // IQ-TREE memory cap passed as `-mem`. Sized for a server; lower it on a
    // laptop (e.g. --iqtree_mem 8G) where 300G is meaningless.
    iqtree_mem        = "300G"

    // Sequence quality filter thresholds
    min_seq_length_ratio   = 0.05   // Minimum real_length as fraction of shortest reference (GenBankParser)
    max_aln_gap_proportion = 0.96   // Maximum allowed gap proportion after nextalign alignment (CollectFilteredSequences)

    // Guards. A defect in the projectability test once deleted 633,988 sequences
    // (16% of the IAV database, 99.98% of all H3) and the run still exited 0.
    // These two turn that class of failure into a hard stop. See MISSING_H3_report.md.
    max_filtered_fraction  = 0.05   // COLLECT_FILTERED_SEQUENCES aborts if non-gap drops exceed this
    max_gap_filtered_fraction = 0.6 // ...or if gap-filter drops (short partials: ~20% RABV, ~35% HCV) exceed this
    min_segment_retention  = 0.98   // CHECK_SEGMENT_RETENTION aborts below this
    
    // Empty placeholders for required inputs
    // This ensures the pipeline fails with a clear error if
    // a user forgets to specify a profile or input params.
    tax_id            = null
    db_name           = null
    // Tree rooting (scripts/TreeReRoot.py). CreateSqliteDB midpoint roots every
    // stored tree, the default for every species because it needs no prior
    // knowledge. NOT YET PASSED THROUGH: setting this has no effect today.
    //
    // Set to one or more tip accessions (comma-separated) to root on an
    // outgroup instead. Give the WHOLE outgroup clade, not one member of it:
    // rooting HCV on MH590700 alone leaves the other three genotype 8
    // references sitting in the ingroup.
    //
    // Segmented viruses need a per-segment outgroup, which this single string
    // cannot express - leave it null there and midpoint root.
    root_outgroup     = null
    ref_list          = null
    bulk_fillup_table = null
    gene_info         = null
    update            = null
    update_db         = null
    gisaid_dir        = null
    ref_set_aligned   = null
    // Backbone alignment (scripts/BuildReferenceAlignment.py). With no curated
    // ref_set_aligned, and outside update mode, a backbone is built from every
    // reference: shared reference indels keep their columns and genes are
    // codon-aligned. false => references are projected onto the master and
    // their insertions stripped to the insertions table, as before.
    build_ref_alignment = true
    // Keep an insertion column in the built backbone only if at least this many
    // references carry bases in it. 1 keeps every reference insertion; dropped
    // bases are written to the insertions table, not lost.
    ref_aln_min_insertion_support = 2
    previous_db       = null // For excluding already processed accessions in GISAID update (optional)
    conda_path        = null
    mutation_catalog  = null
    mutation_virus    = null
    // Optional lookup tables for a catalogue with one evidence reference per
    // row. mutation_catalog.evidence_id joins to publications.evidence_id or
    // clinical_trials.evidence_id, as its data_source column says.
    mutation_publications = null
    mutation_clinical_trials = null
    scripts_dir       = "${projectDir}/scripts"

    // ---------------------------------------------------------------
    // Divergent run mode (opt-in; default OFF).
    // When false nothing below is read and the legacy path is unchanged.
    // See info_help/divergent_mode.md.
    // ---------------------------------------------------------------
    run_divergent_mode        = false
    divergent_genbank         = null      // multi-record GenBank flatfile
    divergent_segments        = "L,M,S"
    divergent_segment_floors  = "L:5500,M:3000,S:2000"
    divergent_seed_accessions = null      // null => every RefSeq reference
    divergent_cluster_evalue     = 1e-2   // orthologue clustering, swept empirically
    divergent_cluster_coverage   = 0.3
    divergent_cluster_identity   = 0
    divergent_extract_iterations = 1      // >1 enables query enrichment; it lost genes here
    divergent_min_taxa           = 4
    divergent_min_gene_coverage  = 0.9    // over cluster representatives, not all taxa
    divergent_cutoff             = "auto" // or a p-distance, e.g. 0.015
    divergent_auto_ceiling       = 0.35   // auto mode ignores bands above this
    // A band must span this fraction of the observed range to be believed.
    // Judged against the spread, not the band's own lower edge: a rule
    // relative to the lower edge is unsatisfiable above ceiling/3 and so
    // rejects real clusters in species that are simply diverse.
    divergent_auto_min_band_frac = 0.15
    divergent_model              = "GTR+I+G4"
    divergent_bootstrap          = 1000
}

// Enforce local server thread ceiling (14 concurrent CPUs max across all tasks)
executor {
    $local {
        cpus = 14
    }
}

// -------------------------------------------------
//  2. PROFILES
// -------------------------------------------------
// specific configurations for different run modes

profiles {

    // The 'standard' profile is used if no flag is provided
    standard {
        process.executor = 'local'
    }

    conda{
        conda.enabled = true
        process.conda = "${projectDir}/environment.yml" // Default env for all processes
    }
//    condamamba{
//        conda.enabled = true
//        conda.useMamba = true
//        conda.cmd = System.getenv('CONDA_EXE') ?: 'conda'
//        process.conda = "${projectDir}/environment.yml" // Default env for all processes
//    }
    // PROFILE: TEST
    // Uses the RABV small dataset for verification
    // PROFILE: DIVERGENT MODE TEST
    // Opt-in path only. Runs on a 33-record Cystoviridae fixture
    // (TaxID 10877) covering all seven RefSeq genomes plus phi6 isolates.
    divergent_test {
        params {
            run_divergent_mode = true
            tax_id            = "10877"
            db_name           = "cystoviridae-divergent-test"
            is_segmented      = "Y"
            test              = "1"
            publish_dir       = "${projectDir}/test_out/divergent_test"
            divergent_genbank = "${projectDir}/test_data/cystoviridae/cystoviridae_test.gb"
            ref_list          = "${projectDir}/test_data/cystoviridae/cystoviridae_ref_list.txt"
            mmseqs_min_seq_id = 0.95
            max_threads       = 8
            divergent_bootstrap = 1000
        }
    }

    // PROFILE: HANTAVIRIDAE DIVERGENT MODE TEST
    // The per-segment path. Cystoviridae cannot exercise it: only its L
    // segment carries a gene recoverable across the divergent taxa, so it
    // yields one backbone however the code is wired. Hantaviridae carries a
    // core gene on L, M and S (RdRp, glycoprotein precursor, nucleocapsid),
    // so a correct run produces three backbones and a wrong one is obvious.
    // Fixture: 12 species x 3 segments plus 9 Puumala isolates, which give
    // every segment a dense cluster for the partition and graft steps.
    hanta_divergent_test {
        params {
            run_divergent_mode = true
            tax_id            = "1980413"
            db_name           = "hantaviridae-divergent-test"
            is_segmented      = "Y"
            test              = "1"
            publish_dir       = "${projectDir}/test_out/hanta_divergent_test"
            divergent_genbank = "${projectDir}/test_data/hantaviridae/hantaviridae_test.gb"
            ref_list          = "${projectDir}/test_data/hantaviridae/hantaviridae_ref_list.txt"
            // Hantaviridae segment lengths, not Cystoviridae's.
            divergent_segment_floors = "L:6000,M:3000,S:1500"
            mmseqs_min_seq_id = 0.95
            max_threads       = 8
            divergent_bootstrap = 1000
        }
    }

    test {
        params {
            tax_id            = "11292"
            db_name           = "rabv-jul0425"
            
            is_segmented      = "N"
            extra_info_fill   = false
            publish_dir       = "${projectDir}/test_out/basic_test"
            
            // Dataset specific paths
            ref_list          = "${projectDir}/test_data/rabv_test_ref_list.txt"
            //gene_info         = "${projectDir}/generic/rabv/Tables/gene_info.csv"
            test = "1"

            mmseqs_min_seq_id =  0.95
            max_threads = 8
            test_max_cluster_seqs = 250
        }
    }

        test_tree_free {
        params {
            tax_id            = "11292"
            db_name           = "rabv-jul0425"
            
            is_segmented      = "N"
            extra_info_fill   = false
            publish_dir       = "${projectDir}/test_out/basic_test_treefree"
            
            // Dataset specific paths
            ref_list          = "${projectDir}/test_data/rabv_test_ref_list.txt"
            //gene_info         = "${projectDir}/generic/rabv/Tables/gene_info.csv"
            test = "1"
            tree_free          = true
            mmseqs_min_seq_id =  0.95
            max_threads = 8
            test_max_cluster_seqs = 250
        }
    }

    // PROFILE: SETUP / PRODUCTION
    // Configuration for the full setup or production run
    setup_rabv_full {
    
        params {
            tax_id            = "11292"
            db_name           = "rabv-jul0425"
            publish_dir       = "${projectDir}/test_out/rabv_test_full_run"

            is_segmented      = "N"
            extra_info_fill   = false

            // Dataset specific paths
            ref_list          = "${projectDir}/generic/rabv/ref_list_clades.txt"
            // Cached backbone: skips the MAFFT build of 497 references. Checked against the
            // reference list by CHECK_REFERENCE_BACKBONE; --ref_set_aligned null rebuilds.
            ref_set_aligned   = "${projectDir}/generic/rabv/ref_set_aligned"
            //gene_info         = "${projectDir}/generic/rabv/Tables/gene_info.csv"
            test = "0"
            mmseqs_min_seq_id =  0.95
        }
    }

    // PROFILE: SETUP / PRODUCTION
    // Configuration for the full setup or production run
    setup_rabv_test_update {
    
        params {
            tax_id            = "11292"
            db_name           = "rabv-jul0425"
            update_db         = '?'
            publish_dir       = "${projectDir}/test_out/rabv_test_update_run"
            
            is_segmented      = "N"

            
            // Dataset specific paths
            ref_list          = "${projectDir}/generic/rabv/ref_list_clades.txt"
            //gene_info         = "${projectDir}/generic/rabv/Tables/gene_info.csv"
            test = "0"
            mmseqs_min_seq_id =  0.98
            extra_info_fill   = false
        }
    }

    // PROFILE: UPDATE TEST
    // Uses outputs from the basic `test` profile as update inputs.
    // Run `-profile test` once before this profile.
    update_test {

        params {
            tax_id            = "11292"
            db_name           = "rabv-jul0425-update-test"
            update_db         = "${projectDir}/test_data/RABV_test/rabv-7Jul26.db"
            publish_dir       = "${projectDir}/test_out/update_test"

            is_segmented      = "N"
            extra_info_fill   = false

            ref_list          = "${projectDir}/test_data/rabv_test_ref_list.txt"
            //gene_info         = "${projectDir}/generic/rabv/Tables/gene_info.csv"
            test              = "1"

            mmseqs_min_seq_id = 0.95
            max_threads       = 4
            test_max_cluster_seqs = 250
        }
    }

    segmented_test {
        params {
            // Core Identity
            tax_id            = "11320"
            db_name           = "iav-db" // Inferred name
            is_segmented      = "Y"
            is_flu            = "Y"
            extra_info_fill   = false // Not used in flu script
            test              = "1"

            
            
            // Input Files (Relative to project root as per shell script)
            ref_list          = "${projectDir}/generic/influenza/ref_list_refmast.txt"
            gene_info         = "${projectDir}/generic/influenza/Tables/gene_info.tsv"
            ref_set_aligned   = "${projectDir}/generic/influenza/ref_set_aligned"
            segment_names     = "${projectDir}/generic/influenza/segment_names_iav.tsv"
            host_aliases      = "${projectDir}/generic/influenza/host-aliases.tsv"
            strain_location_aliases = "${projectDir}/generic/influenza/strain_location_aliases.tsv"
            mutation_catalog  = "${projectDir}/generic/influenza/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/influenza/Tables/publications.csv"
            mutation_virus    = "influenza"
            
            //unimplemented thus far
            // ref_seq_seg       = "${projectDir}/generic-influenza/ref_seq_seg.tsv"
            
            // ref_seq_fna       = "${projectDir}/generic-influenza/ref_seq.fna"
            // exclusion_list    = "${projectDir}/generic-influenza/exclusion_list.tsv"
            // length_threshold  = "${projectDir}/generic-influenza/length_threshold.tsv"
            
            // Reference Directories for Alignment
            // ref_set_split     = "${projectDir}/generic-influenza/ref_set_split/"
            // ref_set_aligned   = "${projectDir}/generic-influenza/ref_set_aligned/"
            
            // Specific Flags
            // genbank_divisions = "PAT SYN" // For FilterAndExtractSequences
            
            // Output
            publish_dir       = "${projectDir}/test_out/IAV_DB"
            mmseqs_min_seq_id = 0.95
            test_max_cluster_seqs = 40
            
        }
    }

    segmented_xml_test {
        params {
            // Core Identity
            // Identical to segmented_test except it reads a frozen GenBank XML
            // snapshot instead of calling NCBI. FETCH_GENBANK was 37.8% of the
            // fresh run (129s of 341s), and more importantly its output depends
            // on what NCBI returns that day - a difference that has already
            // caused a CI failure reproducible nowhere else.
            // Refresh with scripts/fetch_segmented_fixture.sh
            xml_dir           = "${projectDir}/test_data/iav_11320/GenBank-XML"
            tax_id            = "11320"
            db_name           = "iav-db" // Inferred name
            is_segmented      = "Y"
            is_flu            = "Y"
            extra_info_fill   = false // Not used in flu script
            test              = "1"

            
            
            // Input Files (Relative to project root as per shell script)
            ref_list          = "${projectDir}/generic/influenza/ref_list_refmast.txt"
            gene_info         = "${projectDir}/generic/influenza/Tables/gene_info.tsv"
            ref_set_aligned   = "${projectDir}/generic/influenza/ref_set_aligned"
            segment_names     = "${projectDir}/generic/influenza/segment_names_iav.tsv"
            host_aliases      = "${projectDir}/generic/influenza/host-aliases.tsv"
            strain_location_aliases = "${projectDir}/generic/influenza/strain_location_aliases.tsv"
            mutation_catalog  = "${projectDir}/generic/influenza/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/influenza/Tables/publications.csv"
            mutation_virus    = "influenza"
            
            //unimplemented thus far
            // ref_seq_seg       = "${projectDir}/generic-influenza/ref_seq_seg.tsv"
            
            // ref_seq_fna       = "${projectDir}/generic-influenza/ref_seq.fna"
            // exclusion_list    = "${projectDir}/generic-influenza/exclusion_list.tsv"
            // length_threshold  = "${projectDir}/generic-influenza/length_threshold.tsv"
            
            // Reference Directories for Alignment
            // ref_set_split     = "${projectDir}/generic-influenza/ref_set_split/"
            // ref_set_aligned   = "${projectDir}/generic-influenza/ref_set_aligned/"
            
            // Specific Flags
            // genbank_divisions = "PAT SYN" // For FilterAndExtractSequences
            
            // Output
            publish_dir       = "${projectDir}/test_out/IAV_DB"
            mmseqs_min_seq_id = 0.95
            test_max_cluster_seqs = 40
            
        }
    }

    segmented_base_tree {
        params {
            // Core Identity
            tax_id            = "11320"
            db_name           = "iav-db-base-tree"
            is_segmented      = "Y"
            is_flu            = "Y"
            extra_info_fill   = false
            test              = "1"
            base_tree_only    = true

            // Input Files (Relative to project root as per shell script)
            ref_list          = "${projectDir}/generic/influenza/ref_list_refmast.txt"
            gene_info         = "${projectDir}/generic/influenza/Tables/gene_info.tsv"
            ref_set_aligned   = "${projectDir}/generic/influenza/ref_set_aligned"
            segment_names     = "${projectDir}/generic/influenza/segment_names_iav.tsv"
            host_aliases      = "${projectDir}/generic/influenza/host-aliases.tsv"
            strain_location_aliases = "${projectDir}/generic/influenza/strain_location_aliases.tsv"
            mutation_catalog  = "${projectDir}/generic/influenza/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/influenza/Tables/publications.csv"
            mutation_virus    = "influenza"

            // Output
            publish_dir       = "${projectDir}/test_out/IAV_DB_base_tree"
            mmseqs_min_seq_id = 0.95
            test_max_cluster_seqs = 40
        }
    }


    flu_gisaid_test {
        params {
            // Core Identity
            tax_id            = "11320"
            db_name           = "iav-db" // Inferred name
            is_segmented      = "Y"
            is_flu            = "Y"
            extra_info_fill   = false 
            test              = "1"

            // Input Files
            ref_list          = "${projectDir}/generic/influenza/ref_list_refmast.txt"
            gene_info         = "${projectDir}/generic/influenza/Tables/gene_info.tsv"
            ref_set_aligned   = "${projectDir}/generic/influenza/ref_set_aligned"
            segment_names     = "${projectDir}/generic/influenza/segment_names_iav.tsv"
            host_aliases      = "${projectDir}/generic/influenza/host-aliases.tsv"
            strain_location_aliases = "${projectDir}/generic/influenza/strain_location_aliases.tsv"
            mutation_catalog  = "${projectDir}/generic/influenza/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/influenza/Tables/publications.csv"
            mutation_virus    = "influenza"
            
            // GISAID specific
            gisaid_dir        = "${projectDir}/test_data/gisaid_data"

            // Output
            publish_dir       = "${projectDir}/test_out/IAV_DB_GISAID_TEST"
            mmseqs_min_seq_id = 0.95
            test_max_cluster_seqs = 70
        }
    }
    flu_gisaid_xml_laura{
        params{
            xml_dir           = "${projectDir}/test_out/flu_genbank_xml"
            is_segmented      = "Y"
            test              = 0
            publish_dir       = "/home3/oml4h/RABV-gTK/test_out/IAV_DB_gisaid_inc_full" 
            gisaid_dir        = "/home4/lm305z/IAV_DB/flu_vgtk_integrations/tmp/gisaid-data/"
            scripts_dir       = "${projectDir}/RABV-gTK/scripts"
            mmseqs_min_seq_id = "0.95"
            ref_list          = "${projectDir}/generic/influenza/ref_list_refmast.txt"
            gene_info         = "${projectDir}/generic/influenza/Tables/gene_info.tsv"
            ref_set_aligned   = "${projectDir}/generic/influenza/ref_set_aligned"
            segment_names     = "${projectDir}/generic/influenza/segment_names_iav.tsv"
            host_aliases      = "${projectDir}/generic/influenza/host-aliases.tsv"
            strain_location_aliases = "${projectDir}/generic/influenza/strain_location_aliases.tsv"
            mutation_catalog  = "${projectDir}/generic/influenza/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/influenza/Tables/publications.csv"
            mutation_virus    = "influenza"
            tax_id            = "11320"
            db_name           = "iav-db" 
            

        }
    }

    HCV_test {
        params {
            tax_id            = "11103"
            db_name           = "HCV_OM_test"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "1"

            ref_list          = "${projectDir}/generic/hcv/ref_list_subtype_genotype.txt"
            // Cached backbone: skips ~14 min of MAFFT per build. Checked against the
            // reference list by CHECK_REFERENCE_BACKBONE; --ref_set_aligned null rebuilds.
            ref_set_aligned   = "${projectDir}/generic/hcv/ref_set_aligned"
            //gene_info         = "${projectDir}/generic/hcv/Tables/gene_info.tsv"
            mutation_catalog  = "${projectDir}/generic/hcv/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/hcv/Tables/phdr_publication.csv"
            mutation_clinical_trials = "${projectDir}/generic/hcv/Tables/phdr_clinical_trial.csv"
            mutation_virus    = "HCV"

            // Output
            publish_dir       = "${projectDir}/test_out/HCV_OM_test"
            mmseqs_min_seq_id = 0.95
            max_threads       = 8
            test_max_cluster_seqs = 120
            min_seq_length_ratio   = 0.03 
        }
    }

    HCV_full {
        params {
            tax_id            = "11103"
            db_name           = "HCV_full"

            is_segmented      = "N"

            test              = "0"

                        // Output
            publish_dir       = "${projectDir}/test_out/HCV_full"

            ref_list          = "${projectDir}/generic/hcv/ref_list_subtype_genotype.txt"
            // Cached backbone: skips ~14 min of MAFFT per build. Checked against the
            // reference list by CHECK_REFERENCE_BACKBONE; --ref_set_aligned null rebuilds.
            ref_set_aligned   = "${projectDir}/generic/hcv/ref_set_aligned"
            //gene_info         = "${projectDir}/generic/hcv/Tables/gene_info.tsv"
            mutation_catalog  = "${projectDir}/generic/hcv/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/hcv/Tables/phdr_publication.csv"
            mutation_clinical_trials = "${projectDir}/generic/hcv/Tables/phdr_clinical_trial.csv"
            mutation_virus    = "HCV"


            mmseqs_min_seq_id = 0.95
            
            extra_info_fill   = false
        }
    }
    HCV_XML_full {
        params {
            tax_id            = "11103"
            db_name           = "HCV_full"

            is_segmented      = "N"
            extra_info_fill   = false
            test              = "0"

            ref_list          = "${projectDir}/generic/hcv/ref_list_subtype_genotype.txt"
            // Cached backbone: skips ~14 min of MAFFT per build. Checked against the
            // reference list by CHECK_REFERENCE_BACKBONE; --ref_set_aligned null rebuilds.
            ref_set_aligned   = "${projectDir}/generic/hcv/ref_set_aligned"
            //gene_info         = "${projectDir}/generic/hcv/Tables/gene_info.tsv"
            mutation_catalog  = "${projectDir}/generic/hcv/Tables/generalized_mutation_catalog_evidence_linked.tsv"
            mutation_publications = "${projectDir}/generic/hcv/Tables/phdr_publication.csv"
            mutation_clinical_trials = "${projectDir}/generic/hcv/Tables/phdr_clinical_trial.csv"
            mutation_virus    = "HCV"
            //xml_dir = "/home1/jh212a/bin/TING/bash-wf/tmp/GenBank-XML/"
            xml_dir = "/home1/oml4h/RABV-gTK/dev/hcv_XML"
            // Output
            publish_dir       = "${projectDir}/test_out/HCV_XML_full"
            mmseqs_min_seq_id = 0.95
            max_threads       = 14
        }
    }

